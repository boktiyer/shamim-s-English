# Copy this file to .env.local and fill in your values.
# Find them in Supabase: Project Settings -> API (or "Connect").

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# The public address of the site (used for links and SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudflare Stream (SERVER ONLY: never add NEXT_PUBLIC_ to these) ---
# Account ID: Cloudflare dashboard > Stream (right side)
CLOUDFLARE_ACCOUNT_ID=
# API token with permission "Stream: Edit"
CLOUDFLARE_STREAM_API_TOKEN=
# The <CODE> part of https://customer-<CODE>.cloudflarestream.com (Stream > any video > Embed)
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# Filled in automatically by: npm run stream:setup
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_KEY_PEM=

# --- Payments (SERVER ONLY: never add NEXT_PUBLIC_ to these) ---
# Supabase secret key (Project Settings > API Keys > Secret keys, starts with sb_secret_).
# Used ONLY to confirm SSLCommerz payments sent by the gateway.
SUPABASE_SECRET_KEY=
# SSLCommerz store (sandbox: register at https://developer.sslcommerz.com/registration/)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# "true" = sandbox (test money), "false" = live
SSLCOMMERZ_SANDBOX=true
